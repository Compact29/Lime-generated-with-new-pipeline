#!/usr/bin/env python3
"""Small ripgrep launcher with a project-safe fallback for agent workspaces."""

from __future__ import annotations

import fnmatch
import os
from pathlib import Path
import re
import sys


IGNORED_DIRS = {".git", ".next", ".vite", "dist", "node_modules", "__pycache__"}


def find_real_rg() -> str:
    current = Path(__file__).resolve()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(directory or ".") / "rg"
        try:
            if candidate.is_file() and os.access(candidate, os.X_OK) and candidate.resolve() != current:
                return str(candidate)
        except OSError:
            continue
    home = Path.home()
    for candidate in sorted(home.glob(".vscode-server/extensions/*/bin/*/rg"), reverse=True):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return ""


def iter_files(roots: list[str], globs: list[str]):
    for raw_root in roots or ["."]:
        root = Path(raw_root)
        if root.is_file():
            candidates = [root]
        elif root.is_dir():
            candidates = (
                path
                for path in root.rglob("*")
                if path.is_file() and not any(part in IGNORED_DIRS for part in path.parts)
            )
        else:
            continue
        for path in candidates:
            relative = path.as_posix()
            if globs and not any(fnmatch.fnmatch(relative, pattern) or fnmatch.fnmatch(path.name, pattern) for pattern in globs):
                continue
            yield path


def fallback(argv: list[str]) -> int:
    files_only = False
    fixed = False
    ignore_case = False
    line_numbers = False
    list_matches = False
    before = after = 0
    globs: list[str] = []
    positional: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--files":
            files_only = True
        elif arg in ("-F", "--fixed-strings"):
            fixed = True
        elif arg in ("-i", "--ignore-case"):
            ignore_case = True
        elif arg in ("-n", "--line-number"):
            line_numbers = True
        elif arg in ("-l", "--files-with-matches"):
            list_matches = True
        elif arg in ("-g", "--glob") and index + 1 < len(argv):
            index += 1
            globs.append(argv[index].lstrip("!"))
        elif arg in ("-C", "--context", "-A", "--after-context", "-B", "--before-context") and index + 1 < len(argv):
            index += 1
            amount = max(0, int(argv[index]))
            if arg in ("-C", "--context"):
                before = after = amount
            elif arg in ("-A", "--after-context"):
                after = amount
            else:
                before = amount
        elif arg.startswith("-"):
            pass
        else:
            positional.append(arg)
        index += 1

    if files_only:
        for path in iter_files(positional or ["."], globs):
            print(path.as_posix())
        return 0
    if not positional:
        print("rg fallback: missing pattern", file=sys.stderr)
        return 2

    pattern, roots = positional[0], positional[1:] or ["."]
    flags = re.IGNORECASE if ignore_case else 0
    try:
        matcher = re.compile(re.escape(pattern) if fixed else pattern, flags)
    except re.error as error:
        print(f"rg fallback: invalid pattern: {error}", file=sys.stderr)
        return 2

    matched_any = False
    multiple_files = len(roots) > 1 or any(Path(root).is_dir() for root in roots)
    for path in iter_files(roots, globs):
        try:
            lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
        except OSError:
            continue
        hits = [line_index for line_index, line in enumerate(lines) if matcher.search(line)]
        if not hits:
            continue
        matched_any = True
        if list_matches:
            print(path.as_posix())
            continue
        selected = set()
        for hit in hits:
            selected.update(range(max(0, hit - before), min(len(lines), hit + after + 1)))
        last = -2
        for line_index in sorted(selected):
            if line_index > last + 1 and last >= 0:
                print("--")
            prefix = f"{path.as_posix()}:" if multiple_files else ""
            if line_numbers:
                prefix += f"{line_index + 1}:"
            print(f"{prefix}{lines[line_index]}")
            last = line_index
    return 0 if matched_any else 1


def main() -> int:
    real_rg = find_real_rg()
    if real_rg:
        os.execv(real_rg, [real_rg, *sys.argv[1:]])
    return fallback(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
